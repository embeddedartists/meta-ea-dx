From fe8c651bf398c5506ccd6d2d629665e3671995d6 Mon Sep 17 00:00:00 2001
From: Andreas Rebert <andreas.rebert@embeddedartists.com>
Date: Mon, 25 May 2026 11:35:46 +0000
Subject: [PATCH] Remove reference to TMPDIR 2

Upstream-Status: Inappropriate [EA specific]
---
 src/cpp_example/common/utility/common_util.hpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/cpp_example/common/utility/common_util.hpp b/src/cpp_example/common/utility/common_util.hpp
index 9e8be38..a8ac0c4 100644
--- a/src/cpp_example/common/utility/common_util.hpp
+++ b/src/cpp_example/common/utility/common_util.hpp
@@ -631,7 +631,10 @@ constexpr const char* SETUP_FILE_PATH = "setup.sh --force";
     catch (const dxrt::Exception& e) {                                                           \
         std::cerr << DXAPP_RED << e.what() << " error-code=" << e.code() << DXAPP_RESET          \
                   << std::endl;                                                                  \
-        fs::path dx_app_dir(fs::canonical(PROJECT_ROOT_DIR));                                    \
+        /* Cannot use PROJECT_ROOT_DIR here as it is an absolute path on the build server, */    \
+        /* not a valid path in runtime (i.e. on target). Having PROJECT_ROOT_DIR here will */    \
+        /* result in yocto QA Issue errors about references to TMPDIR. */                        \
+        fs::path dx_app_dir = "";                                                                \
         fs::path setup_script = dx_app_dir / SETUP_FILE_PATH;                                    \
         std::cerr << "dx_app_dir: " << dx_app_dir.string() << std::endl;                         \
         if (e.code() == 257) {                                                                   \
